# ─────────────────────────────────────────────
#  OceanSmart Backend — Environment Variables
#  Salin file ini menjadi .env lalu isi nilainya
# ─────────────────────────────────────────────

# === DATABASE ===
# Format: mysql+pymysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>
# Jika password MySQL kosong (default Laragon/XAMPP): root:@localhost
DATABASE_URL=mysql+pymysql://root:@localhost:3306/oceansmart

# === AI / LLM API KEYS ===
# Letakkan API key di file ini. JANGAN commit file .env ke Git.

# Google Gemini API (utama) — dapatkan di https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Mistral AI API (fallback) — dapatkan di https://console.mistral.ai/
MISTRAL_API_KEY=
